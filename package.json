{
  "name": "dsh-web-ai-discuss",
  "version": "0.1.0",
  "private": true,
  "description": "把已登录的网页版 DeepSeek 接入 DSH 工作流，作为外部思路讨论来源（经 ego lite 桥接，零协议构造）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
